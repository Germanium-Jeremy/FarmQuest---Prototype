[TEMPLATE]
# Server Configuration
PORT=80
ADMIN_TOKEN=your-secret-admin-token-change-me
DATABASE_URL=./farmquest.db

# Upload storage for collaborator logos
UPLOAD_DIR=./uploads
MAX_LOGO_SIZE_MB=5

# Email (optional)
EMAIL_PROVIDER=development
EMAIL_FROM=FarmQuest <rewards@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Public base URL for email assets (e.g. https://farmquest.app)
PUBLIC_BASE_URL=http://localhost:3001
