# FarmQuest Server Configuration
# Copy this file to .env and configure the values

# Server port
PORT=3001

# Database path (SQLite)
# For Docker: /app/data/farmquest.db (set in docker-compose.yml, overridden here)
# For local dev: ./data/farmquest.db or /home/deploy/farmquest/data/farmquest.db
DATABASE_URL=./data/farmquest.db

# Email configuration
EMAIL_PROVIDER=smtp
EMAIL_FROM=FarmQuest <rewards@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1:3000,http://168.231.85.220

# Admin token (generate with: openssl rand -hex 16)
ADMIN_TOKEN=change-me-to-a-secure-token

# Application port for nginx (if using nginx)
NGINX_PORT=80
